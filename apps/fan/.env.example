# ============================================
# TON-PASS Environment Variables
# Copy this to .env.local and fill in values
# ============================================

# ── Supabase ──────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── NextAuth ──────────────────────────────
NEXTAUTH_URL=https://your-app.vercel.app
NEXTAUTH_SECRET=your-very-long-random-secret-32chars+

# ── Twitter OAuth 2.0 ────────────────────
# Create at developer.twitter.com → Projects → App
# Add callback: https://your-app.vercel.app/api/auth/callback/twitter
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret

# ── TON ──────────────────────────────────
# Get from toncenter.com (free tier available)
TON_API_KEY=your-toncenter-api-key
# Set to 'testnet' for development
TON_NETWORK=mainnet

# ── Telegram Bot ─────────────────────────
# Create via @BotFather on Telegram
# 1. /newbot → get token
# 2. Set up Mini App: /newapp → link to your Vercel URL
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ── TonConnect ───────────────────────────
NEXT_PUBLIC_TONCONNECT_MANIFEST_URL=https://your-app.vercel.app/tonconnect-manifest.json

# ── Cron (cron-job.org) ──────────────────
# Random secret to protect cron endpoint
# Set same value in cron-job.org header: x-cron-secret
CRON_SECRET=your-random-cron-secret-here
